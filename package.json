{
  "name": "opuspopuli-sdlc-tooling",
  "private": true,
  "description": "Internal tooling for the control registry. Not an npm package — this repo is a Claude Code plugin; see README.md.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "validate": "node --experimental-strip-types controls/scripts/validate.ts",
    "pin": "node --experimental-strip-types controls/scripts/pin.ts",
    "docs:generate": "node --experimental-strip-types controls/scripts/generate-docs.ts",
    "docs:check": "node --experimental-strip-types controls/scripts/generate-docs.ts --check",
    "reconcile": "node --experimental-strip-types controls/scripts/reconcile.ts",
    "profile:check": "node --experimental-strip-types controls/scripts/validate-profile.ts",
    "test": "node --experimental-strip-types --test \"controls/scripts/*.test.ts\"",
    "check": "npm run validate && npm run docs:check && npm run reconcile && npm run profile:check && npm test"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.0"
  }
}
